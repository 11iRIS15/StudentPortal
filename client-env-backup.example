# Copy this file to .env and fill in your values.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
# Commit .env.example. NEVER commit .env.
# Everything here ends up in the browser, so NEVER put secrets in it.

# Base URL of this module's backend API.
# The prefix depends on your framework:
#   Vite (React/Vue/Svelte): VITE_       Next.js: NEXT_PUBLIC_
#   Angular: use src/environments/ instead of this file
VITE_API_BASE_URL=http://localhost:8000/api/v1
